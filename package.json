{
  "name": "unified-management-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Unified tournament management platform with mobile-first PWA and plugin extensibility",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:federation": "concurrently \"pnpm --filter @ump/backend dev\" \"pnpm --filter @ump/gateway dev\"",
    "start:federation": "concurrently \"pnpm --filter @ump/backend start\" \"pnpm --filter @ump/gateway start\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:validate": "node scripts/validate-docker-setup.js",
    "docker:reset": "docker compose down -v --rmi all && docker compose up -d --build",
    "docker:test-release": "node scripts/test-docker-release.js",
    "docker:test-gh-trigger": "node scripts/test-gh-release-trigger.js",
    "test:docker-release": "npm run docker:test-release && npm run docker:test-gh-trigger",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --coverage --ci --watchAll=false --passWithNoTests",
    "test:coverage:verify": "node scripts/test-coverage-enforcement.js",
    "test:contract": "pnpm --filter @ump/mobile test:contract && pnpm --filter @ump/admin test:contract && pnpm --filter @ump/gateway test:contract",
    "test:contract:consumer": "pnpm --filter @ump/mobile test:contract && pnpm --filter @ump/admin test:contract",
    "test:contract:provider": "pnpm --filter @ump/gateway test:contract",
    "type-check": "tsc -b",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:watch": "graphql-codegen --config codegen.yml --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lhci": "lhci",
    "lhci:autorun": "lhci autorun",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "secret-scan": "echo 'Secret scanning requires gitleaks binary. Please install from https://github.com/gitleaks/gitleaks/releases or use the GitHub Action.'",
    "secret-scan:ci": "echo 'Secret scanning requires gitleaks binary. Please install from https://github.com/gitleaks/gitleaks/releases or use the GitHub Action.'",
    "test:secret-scan": "node scripts/test-secret-scan.js"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-query": "^6.1.0",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "adr-tools": "^2.0.4",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.5.0",
    "chromatic": "^11.20.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "graphql": "^16.9.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "js-yaml": "^4.1.0",
    "lint-staged": "^14.0.1",
    "postcss": "^8.4.32",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.6.12",
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --ignore-pattern '**/cypress/**'",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
