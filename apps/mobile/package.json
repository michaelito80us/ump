{
  "name": "@ump/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3001",
    "lint": "next lint",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:contract": "jest __tests__/contract/consumer.test.ts",
    "test:contract:watch": "jest __tests__/contract/consumer.test.ts --watch",
    "type-check": "tsc --noEmit",
    "validate-translations": "tsx scripts/validate-translations.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "convert-icons": "tsx scripts/convert-icons.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test dev http://localhost:3001/en cypress:run",
    "e2e:open": "start-server-and-test dev http://localhost:3001/en cypress:open",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:a11y:headed": "playwright test tests/e2e/a11y.spec.ts --headed",
    "test:a11y:ui": "playwright test tests/e2e/a11y.spec.ts --ui"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@clerk/nextjs": "^6.31.1",
    "@ump/core": "workspace:*",
    "@ump/engine": "workspace:*",
    "@ump/ui": "workspace:*",
    "framer-motion": "^12.23.12",
    "graphql": "^16.9.0",
    "graphql-ws": "^6.0.6",
    "next": "^15.3.2",
    "next-intl": "^4.3.4",
    "next-pwa": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.33.0",
    "@pact-foundation/pact": "^15.0.1",
    "@playwright/test": "^1.54.2",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.15.21",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "autoprefixer": "^10.4.16",
    "cypress": "^13.17.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.5",
    "eslint-plugin-cypress": "^5.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-fetch": "2",
    "postcss": "^8.4.32",
    "start-server-and-test": "^2.0.13",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.3"
  }
}
