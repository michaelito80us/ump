# Production Dockerfile for Mobile App
FROM node:18-alpine AS base

# Install dependencies only when needed
FROM base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/core/package.json ./packages/core/
COPY packages/ui/package.json ./packages/ui/
COPY packages/engine/package.json ./packages/engine/
COPY packages/plugins/package.json ./packages/plugins/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/core/package.json ./packages/core/
COPY packages/ui/package.json ./packages/ui/
COPY packages/engine/package.json ./packages/engine/
COPY packages/plugins/package.json ./packages/plugins/

# Install all dependencies (including devDependencies)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY apps/mobile ./apps/mobile
COPY packages/core ./packages/core
COPY packages/ui ./packages/ui
COPY packages/engine ./packages/engine
COPY packages/plugins ./packages/plugins
COPY tsconfig.base.json ./
COPY codegen.yml ./
COPY schema.graphql ./

# Build dependencies
RUN pnpm --filter @ump/core build
RUN pnpm --filter @ump/engine build
RUN pnpm --filter @ump/ui build
RUN pnpm --filter @ump/plugins build

# Set build-time environment variables
ARG NODE_ENV=production
ARG NEXT_PUBLIC_GRAPHQL_HTTP_URL
ARG NEXT_PUBLIC_GRAPHQL_WS_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_CDN_URL
ARG NEXT_PUBLIC_ASSET_PREFIX
ARG NEXT_PUBLIC_APP_VERSION
ARG NEXT_PUBLIC_BUILD_NUMBER

ENV NODE_ENV=${NODE_ENV}
ENV NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application
RUN pnpm --filter @ump/mobile build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy the public folder
COPY --from=builder /app/apps/mobile/public ./apps/mobile/public

# Set the correct permission for prerender cache
RUN mkdir -p /app/apps/mobile/.next
RUN chown nextjs:nodejs /app/apps/mobile/.next

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/apps/mobile/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/mobile/.next/static ./apps/mobile/.next/static

# Copy production dependencies
COPY --from=deps --chown=nextjs:nodejs /app/node_modules ./node_modules

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node", "apps/mobile/server.js"]