# Production Environment Configuration for Mobile App

# Clerk Authentication (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}
CLERK_SECRET_KEY=${CLERK_SECRET_KEY}

# GraphQL API Endpoints (Production)
NEXT_PUBLIC_GRAPHQL_HTTP_URL=${GRAPHQL_HTTP_URL}
NEXT_PUBLIC_GRAPHQL_WS_URL=${GRAPHQL_WS_URL}

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=${WS_URL}
NEXT_PUBLIC_WS_ENABLE_LOGGING=false
NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS=5

# Production Settings
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Security
JWT_SECRET=${JWT_SECRET}

# Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_ID=${ANALYTICS_ID}
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}

# CDN and Assets
NEXT_PUBLIC_CDN_URL=${CDN_URL}
NEXT_PUBLIC_ASSET_PREFIX=${ASSET_PREFIX}

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true

# Mobile Specific
NEXT_PUBLIC_APP_NAME="UMP Mobile"
NEXT_PUBLIC_APP_VERSION=${APP_VERSION}
NEXT_PUBLIC_BUILD_NUMBER=${BUILD_NUMBER}

# Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
VAPID_SUBJECT=${VAPID_SUBJECT}