  "interactions": [
    {
      "description": "a request for audit logs",
      "providerState": "tournament with ID 1 has audit logs and user has admin permissions",
      "request": {
        "body": {
          "operationName": "GetAuditLogs",
          "query": "\n  query GetAuditLogs($tournamentId: ID!, $limit: Int, $offset: Int) {\n    auditLogs(tournamentId: $tournamentId, limit: $limit, offset: $offset) {\n      id\n      action\n      entityType\n      entityId\n      userId\n      timestamp\n      details\n    }\n  }\n",
          "variables": {
            "limit": 20,
            "offset": 0,
            "tournamentId": "1"
          }
        },
        "headers": {
          "Authorization": "Bearer admin-jwt-token",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body": {
            "match": "type"
          },
          "$.body.variables": {
            "match": "type"
          },
          "$.header.Authorization": {
            "match": "type"
          }
        },
        "method": "POST",
        "path": "/graphql"
      },
      "response": {
        "body": {
          "data": {
            "auditLogs": [
              {
                "action": "UPDATE",
                "details": {
                  "field": "name",
                  "newValue": "New Name",
                  "oldValue": "Old Name"
                },
                "entityId": "1",
                "entityType": "TOURNAMENT",
                "id": "log-1",
                "timestamp": "2025-04-01T12:00:00Z",
                "userId": "admin-user-id"
              }
            ]
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.data.auditLogs": {
            "match": "type",
            "min": 1
          },
          "$.body.data.auditLogs[*].action": {
            "match": "regex",
            "regex": "CREATE|UPDATE|DELETE|PUBLISH|CANCEL"
          },
          "$.body.data.auditLogs[*].details": {
            "match": "type"
          },
          "$.body.data.auditLogs[*].entityId": {
            "match": "type"
          },
          "$.body.data.auditLogs[*].entityType": {
            "match": "regex",
            "regex": "TOURNAMENT|MATCH|TEAM|PLAYER"
          },
          "$.body.data.auditLogs[*].id": {
            "match": "type"
          },
          "$.body.data.auditLogs[*].timestamp": {
            "match": "type"
          },
          "$.body.data.auditLogs[*].userId": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
