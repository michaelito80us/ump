          "$.body.data.tournament.settings.allowLateRegistration": {
            "match": "type"
          },
          "$.body.data.tournament.settings.maxTeams": {
            "match": "type"
          },
          "$.body.data.tournament.settings.registrationDeadline": {
            "match": "type"
          },
          "$.body.data.tournament.startDate": {
            "match": "type"
          },
          "$.body.data.tournament.status": {
            "match": "regex",
