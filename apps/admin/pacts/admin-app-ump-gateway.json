          },
          "$.body.data.tournament.phases[*].matches[*].id": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].scoreA": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].scoreB": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].startTime": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].status": {
            "match": "regex",
            "regex": "SCHEDULED|LIVE|COMPLETED|CANCELLED"
          },
          "$.body.data.tournament.phases[*].matches[*].teamA.id": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].teamA.name": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].teamB.id": {
            "match": "type"
          },
          "$.body.data.tournament.phases[*].matches[*].teamB.name": {
