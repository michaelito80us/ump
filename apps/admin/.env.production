# Production Environment Configuration for Admin App

# Clerk Authentication (Production)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
# CLERK_SECRET_KEY=your_clerk_secret_key_here

# GraphQL API Endpoints (Production)
# NEXT_PUBLIC_GRAPHQL_HTTP_URL=https://your-api.com/graphql
# NEXT_PUBLIC_GRAPHQL_WS_URL=wss://your-api.com/graphql

# WebSocket Configuration
# NEXT_PUBLIC_WS_URL=wss://your-ws.com
NEXT_PUBLIC_WS_ENABLE_LOGGING=false
NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS=5

# Production Settings
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Security
# JWT_SECRET=your_jwt_secret_here

# Analytics and Monitoring
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# CDN and Assets
# NEXT_PUBLIC_CDN_URL=https://your-cdn.com
# NEXT_PUBLIC_ASSET_PREFIX=https://your-assets.com

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true