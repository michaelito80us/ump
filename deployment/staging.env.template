# Staging Environment Configuration Template
# Copy this file to .env.staging and update with your actual staging values

# Application Settings
NODE_ENV=staging
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://ump_user:password@staging-db.ump-platform.com:5432/ump_staging
REDIS_URL=redis://staging-redis.ump-platform.com:6379

# External Services
OPENAI_API_KEY=sk-staging-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
SENDGRID_API_KEY=SG.staging...

# AWS Configuration
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=ump-staging-uploads

# Cloudflare
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ZONE_ID=...

# Monitoring & Analytics
SENTRY_DSN=https://...@sentry.io/...
NEW_RELIC_LICENSE_KEY=...
DATADOG_API_KEY=...
MIXPANEL_TOKEN=...

# Firebase (for mobile push notifications)
FIREBASE_PROJECT_ID=ump-staging
FIREBASE_PRIVATE_KEY=...
FIREBASE_CLIENT_EMAIL=...

# Security
JWT_SECRET=staging-jwt-secret-key
ENCRYPTION_KEY=staging-encryption-key

# API Configuration
API_BASE_URL=https://staging.ump-platform.com
FRONTEND_URL=https://staging-app.ump-platform.com
ADMIN_URL=https://staging-admin.ump-platform.com

# Performance Testing
K6_TARGET_URL=https://staging.ump-platform.com
API_TOKEN=staging-test-token-123

# Deployment
DOCKER_REGISTRY=staging-registry.ump-platform.com
KUBERNETES_NAMESPACE=ump-staging