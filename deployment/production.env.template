# UMP Production Environment Variables Template
# Copy this file and replace placeholder values with actual production values

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
CLERK_SECRET_KEY=sk_live_your_production_secret_key

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_256_bits_minimum

# =============================================================================
# DATABASE & CACHE
# =============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@your-db-host:5432/ump_production

# Redis Cache
REDIS_URL=redis://username:password@your-redis-host:6379

# =============================================================================
# API ENDPOINTS
# =============================================================================

# GraphQL Endpoints
GRAPHQL_HTTP_URL=https://api.yourdomain.com/graphql
GRAPHQL_WS_URL=wss://api.yourdomain.com/graphql

# WebSocket
WS_URL=wss://ws.yourdomain.com
WS_PORT=4002

# Core Subgraph
CORE_SUBGRAPH_URL=https://core.yourdomain.com/graphql

# Plugin Registry
PLUGIN_REGISTRY_URL=https://plugins.yourdomain.com

# Plugin Subgraphs (comma-separated: name:url)
PLUGIN_SUBGRAPHS=basketball:https://basketball.yourdomain.com/graphql,soccer:https://soccer.yourdomain.com/graphql

# =============================================================================
# CORS & SECURITY
# =============================================================================

# CORS Origins (comma-separated)
CORS_ORIGIN=https://admin.yourdomain.com,https://mobile.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com,https://mobile.yourdomain.com

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_ORG_ID=org-your_organization_id

# Stripe Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=UMP Platform

# =============================================================================
# CLOUD STORAGE
# =============================================================================

# AWS S3
AWS_ACCESS_KEY_ID=AKIA_your_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ump-prod-storage
AWS_S3_BACKUP_BUCKET=ump-prod-backups

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# New Relic APM
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=UMP Production

# Datadog
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
DD_SITE=datadoghq.com

# Analytics
ANALYTICS_ID=your_analytics_tracking_id
MIXPANEL_TOKEN=your_mixpanel_token
GA_TRACKING_ID=G-XXXXXXXXXX

# =============================================================================
# CDN & ASSETS
# =============================================================================

# CDN Configuration
CDN_URL=https://cdn.yourdomain.com
ASSET_PREFIX=https://cdn.yourdomain.com

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================

# VAPID Keys for Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_SERVER_KEY=your_firebase_server_key

# =============================================================================
# APPLICATION METADATA
# =============================================================================

# App Version
APP_VERSION=1.0.0
BUILD_NUMBER=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Analytics Features
ENABLE_ANALYTICS=true
ENABLE_MIXPANEL=true
ENABLE_GA=true

# Monitoring Features
ENABLE_MONITORING=true
ENABLE_SENTRY=true
ENABLE_DATADOG=false
ENABLE_NEW_RELIC=false

# Application Features
ENABLE_WEBSOCKETS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# GraphQL Configuration
GRAPHQL_INTROSPECTION=false
GRAPHQL_PLAYGROUND=false
GRAPHQL_DEBUG=false

# =============================================================================
# LOGGING & PERFORMANCE
# =============================================================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
NODE_ENV=production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5000

# Performance
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=128

# =============================================================================
# BACKUP & SECURITY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
MIGRATION_PASSWORD=your_migration_password

# Security
ENCRYPTION_KEY=your_32_character_encryption_key
SESSION_SECRET=your_session_secret_key
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_MAX_AGE=31536000

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Service Ports (for container orchestration)
ADMIN_PORT=3000
MOBILE_PORT=3001
GATEWAY_PORT=3000
BACKEND_PORT=4001
WS_PORT=4002