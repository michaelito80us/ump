# Production Dockerfile for Gateway Service
FROM node:18-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/gateway/package.json ./packages/gateway/
COPY packages/core/package.json ./packages/core/
COPY packages/plugins/package.json ./packages/plugins/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache libc6-compat

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/gateway/package.json ./packages/gateway/
COPY packages/core/package.json ./packages/core/
COPY packages/plugins/package.json ./packages/plugins/

# Install all dependencies (including devDependencies)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/gateway ./packages/gateway
COPY packages/core ./packages/core
COPY packages/plugins ./packages/plugins
COPY tsconfig.base.json ./
COPY schema.graphql ./

# Build dependencies
RUN pnpm --filter @ump/core build
RUN pnpm --filter @ump/plugins build

# Build the gateway
RUN pnpm --filter @ump/gateway build

# Production image
FROM base AS runner
WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache curl

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 gateway

# Copy built application
COPY --from=builder --chown=gateway:nodejs /app/packages/gateway/dist ./packages/gateway/dist
COPY --from=builder --chown=gateway:nodejs /app/packages/gateway/package.json ./packages/gateway/

# Copy built dependencies
COPY --from=builder --chown=gateway:nodejs /app/packages/core/dist ./packages/core/dist
COPY --from=builder --chown=gateway:nodejs /app/packages/plugins/dist ./packages/plugins/dist

# Copy production dependencies
COPY --from=deps --chown=gateway:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=gateway:nodejs /app/packages/gateway/node_modules ./packages/gateway/node_modules

# Copy package.json files
COPY --chown=gateway:nodejs package.json pnpm-workspace.yaml ./
COPY --chown=gateway:nodejs packages/core/package.json ./packages/core/
COPY --chown=gateway:nodejs packages/plugins/package.json ./packages/plugins/

USER gateway

EXPOSE 3000

ENV PORT=3000
ENV HOST=0.0.0.0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start the application
CMD ["node", "packages/gateway/dist/index.js"]