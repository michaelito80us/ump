# Production Environment Configuration for Gateway

# Gateway Configuration
PORT=${PORT:-3000}
HOST=0.0.0.0
NODE_ENV=production

# GraphQL Configuration
GRAPHQL_INTROSPECTION=false
GRAPHQL_PLAYGROUND=false
GRAPHQL_DEBUG=false

# CORS Configuration
CORS_ORIGINS=${CORS_ORIGINS}
CORS_CREDENTIALS=true

# Authentication
JWT_SECRET=${JWT_SECRET}

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Core Subgraph
CORE_SUBGRAPH_URL=${CORE_SUBGRAPH_URL}
CORE_SUBGRAPH_TIMEOUT=30000

# Plugin Registry
PLUGIN_REGISTRY_URL=${PLUGIN_REGISTRY_URL}
PLUGIN_REGISTRY_TIMEOUT=10000

# Plugin Subgraphs
PLUGIN_SUBGRAPHS=${PLUGIN_SUBGRAPHS}

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# Security
HELMET_ENABLED=true
TRUST_PROXY=true

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
NEW_RELIC_LICENSE_KEY=${NEW_RELIC_LICENSE_KEY}

# Caching
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Federation
FEDERATION_POLLING_INTERVAL=30000
FEDERATION_RETRY_ATTEMPTS=3
FEDERATION_RETRY_DELAY=1000