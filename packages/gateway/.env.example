# Gateway Configuration
PORT=3000
NODE_ENV=development

# GraphQL Configuration
GRAPHQL_INTROSPECTION=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication
JWT_SECRET=your-jwt-secret-here

# Logging
LOG_LEVEL=INFO

# Core Subgraph
CORE_SUBGRAPH_URL=http://localhost:4001/graphql

# Plugin Registry (optional)
# PLUGIN_REGISTRY_URL=http://localhost:4002

# Development Plugin Subgraphs (optional)
# Format: name1:url1,name2:url2
# PLUGIN_SUBGRAPHS=basketball:http://localhost:4003/graphql,soccer:http://localhost:4004/graphql