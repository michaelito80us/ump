{
  "name": "@ump/gateway",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:contract": "jest --config jest.contract.config.js",
    "test:contract:provider": "jest --config jest.contract.config.js tests/contract/provider.test.ts",
    "test:all": "npm run test && npm run test:contract",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "compose": "rover supergraph compose --config supergraph.yaml"
  },
  "dependencies": {
    "@apollo/gateway": "^2.5.0",
    "@apollo/server": "^4.10.0",
    "@apollo/subgraph": "^2.6.0",
    "@ump/core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.9.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@graphql-tools/mock": "^9.0.25",
    "@pact-foundation/pact": "^15.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "graphql-tag": "^2.12.6",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/contract/"
    ],
    "moduleNameMapper": {
      "^@ump/core$": "<rootDir>/../core/src/index.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@ump)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/__tests__/**"
    ]
  }
}
